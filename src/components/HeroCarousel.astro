---
import { Image } from 'astro:assets';
import slideEcommerce from '../assets/hero-ecommerce.jpg';
import slideOdoo from '../assets/hero-odoo.jpg';
import slideCustom from '../assets/hero-custom.jpg';
import slideAutomation from '../assets/hero-automation.jpg';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { capabilities, heroSlides } from '../data/site';

const images = {
  ecommerce: slideEcommerce,
  odoo: slideOdoo,
  custom: slideCustom,
  automation: slideAutomation,
} as const;
---
<section
  id="hero-carousel"
  class="relative overflow-hidden bg-navy-deep text-white"
  aria-roledescription="carousel"
  aria-label="Featured capabilities"
>
  <div class="pointer-events-none absolute inset-0 circuit-grid opacity-50"></div>
  <div class="pointer-events-none absolute -left-24 top-12 h-72 w-72 rounded-full bg-gold/12 blur-3xl"></div>
  <div class="pointer-events-none absolute right-0 bottom-0 h-80 w-80 rounded-full bg-cyan/10 blur-3xl"></div>

  <div class="relative">
    {
      heroSlides.map((slide, i) => (
        <article
          class:list={['hero-slide', i === 0 && 'is-active']}
          data-slide={i}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <div class="absolute inset-0 overflow-hidden">
            <Image
              src={images[slide.image as keyof typeof images]}
              alt=""
              class="hero-kenburns h-full w-full object-cover opacity-25"
              widths={[960, 1440, 1920]}
              sizes="100vw"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-navy-deep via-navy-deep/92 to-navy-deep/70"></div>
          </div>

          <div class="container-site relative grid items-center gap-8 py-12 lg:grid-cols-12 lg:gap-10 lg:py-16">
            <div class="hero-copy lg:col-span-5">
              <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">{slide.eyebrow}</p>
              <h1 class="mt-4 max-w-xl text-3xl font-semibold tracking-tight sm:text-4xl lg:text-[2.75rem] lg:leading-[1.15]">
                {slide.title} <span class="text-gold">{slide.accent}</span>
              </h1>
              <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-white/75">{slide.text}</p>
              <div class="mt-8 flex flex-wrap gap-3">
                <Button href={slide.primary.href} variant="gold">{slide.primary.label}</Button>
                <Button href={slide.secondary.href} variant="ghost-light">{slide.secondary.label}</Button>
              </div>
            </div>

            <div class="hero-copy lg:col-span-7">
              <figure class="relative">
                <div class="absolute -inset-3 rounded-2xl bg-cyan/15 blur-2xl"></div>
                <div class="relative overflow-hidden rounded-xl border border-white/15 bg-navy shadow-[0_24px_60px_rgba(0,0,0,0.45)] ring-1 ring-gold/30">
                  <div class="flex items-center gap-1.5 border-b border-white/10 bg-navy-mid px-4 py-2">
                    <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-white/25"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-gold/80"></span>
                    <span class="ml-3 truncate text-[11px] tracking-wide text-white/50">{slide.eyebrow}</span>
                  </div>
                  <Image
                    src={images[slide.image as keyof typeof images]}
                    alt={slide.eyebrow}
                    class="aspect-[16/10] h-auto w-full object-cover object-center"
                    widths={[720, 1080, 1440]}
                    sizes="(min-width: 1024px) 620px, 100vw"
                  />
                </div>
              </figure>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="relative border-t border-white/10 bg-navy-deep/80 backdrop-blur-sm">
    <div class="container-site flex flex-col gap-6 py-5 lg:flex-row lg:items-center lg:justify-between">
      <ul class="grid flex-1 grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        {
          capabilities.map((item) => (
            <li class="flex items-center gap-2 text-white/80">
              <span class="grid h-8 w-8 place-items-center rounded-full border border-cyan/30 text-cyan">
                <Icon name={item.icon} class="h-3.5 w-3.5" />
              </span>
              <span class="text-xs font-medium tracking-wide sm:text-sm">{item.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center justify-between gap-4 lg:justify-end">
        <div class="flex gap-2" role="tablist" aria-label="Slide controls">
          {
            heroSlides.map((slide, i) => (
              <button
                type="button"
                class="hero-dot group relative h-2 w-10 overflow-hidden rounded-full bg-white/20"
                data-dot={i}
                aria-label={`Show slide ${i + 1}: ${slide.eyebrow}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <span class:list={['hero-progress absolute inset-0 bg-gold', i === 0 && 'is-running']}></span>
              </button>
            ))
          }
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            id="hero-prev"
            class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white hover:border-cyan hover:text-cyan"
            aria-label="Previous slide"
          >
            <Icon name="arrow" class="h-4 w-4 rotate-180" />
          </button>
          <button
            type="button"
            id="hero-next"
            class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white hover:border-cyan hover:text-cyan"
            aria-label="Next slide"
          >
            <Icon name="arrow" class="h-4 w-4" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const INTERVAL = 7000;
  const root = document.getElementById('hero-carousel');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const bars = [...root.querySelectorAll<HTMLElement>('.hero-progress')];
    let index = 0;
    let timer: number | undefined;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const go = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const on = i === index;
        slide.classList.toggle('is-active', on);
        slide.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
      bars.forEach((bar, i) => {
        bar.classList.remove('is-running');
        void bar.offsetWidth;
        if (i === index && !reduce) bar.classList.add('is-running');
      });
    };

    const play = () => {
      if (reduce) return;
      window.clearInterval(timer);
      timer = window.setInterval(() => go(index + 1), INTERVAL);
    };

    root.querySelector('#hero-prev')?.addEventListener('click', () => {
      go(index - 1);
      play();
    });
    root.querySelector('#hero-next')?.addEventListener('click', () => {
      go(index + 1);
      play();
    });
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        go(i);
        play();
      });
    });

    root.addEventListener('mouseenter', () => window.clearInterval(timer));
    root.addEventListener('mouseleave', play);

    let startX = 0;
    root.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
    });
    root.addEventListener('pointerup', (event) => {
      const dx = event.clientX - startX;
      if (Math.abs(dx) < 50) return;
      go(index + (dx < 0 ? 1 : -1));
      play();
    });

    play();
  }
</script>
