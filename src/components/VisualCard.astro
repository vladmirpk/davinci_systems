---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../lib/paths';

interface Props {
  href: string;
  title: string;
  summary: string;
  image: ImageMetadata;
  process?: string;
}

const { href, title, summary, image, process } = Astro.props;
---
<a
  href={withBase(href)}
  class="group reveal flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-[0_8px_24px_rgba(18,38,63,0.04)] transition duration-300 hover:-translate-y-1 hover:border-gold/40 hover:shadow-[0_18px_40px_rgba(18,38,63,0.1)]"
>
  <div class="relative overflow-hidden">
    <Image
      src={image}
      alt={title}
      class="h-48 w-full object-cover transition duration-700 group-hover:scale-105"
      widths={[480, 720]}
      sizes="(min-width: 1024px) 360px, 100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-deep/50 to-transparent"></div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    {process && <p class="text-[11px] font-semibold tracking-[0.14em] text-gold uppercase">{process}</p>}
    <h3 class="mt-2 text-lg font-semibold text-navy">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{summary}</p>
    <span class="mt-4 text-sm font-semibold text-navy group-hover:text-gold">View the journey →</span>
  </div>
</a>
