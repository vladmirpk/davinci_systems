---
interface Props {
  from?: 'white' | 'mist' | 'navy';
  to?: 'white' | 'mist' | 'navy';
}

const fills = { white: '#ffffff', mist: '#f4f6f9', navy: '#12263f' };
const { from = 'white', to = 'mist' } = Astro.props;
---
<div class="relative -mb-px leading-none" aria-hidden="true">
  <svg viewBox="0 0 1440 72" class="block w-full" preserveAspectRatio="none">
    <path d="M0,24 C240,72 480,0 720,32 C960,64 1200,8 1440,40 L1440,72 L0,72 Z" fill={fills[to]}></path>
    <path d="M0,24 C240,72 480,0 720,32 C960,64 1200,8 1440,40" fill="none" stroke="#c9a227" stroke-opacity="0.35" stroke-width="1.5"></path>
  </svg>
</div>
