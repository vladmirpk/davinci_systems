---
import Icon from './Icon.astro';

interface Props {
  steps: { n: string; title: string; text: string }[];
  title?: string;
  eyebrow?: string;
}

const { steps, title = 'End to end', eyebrow = 'How it runs' } = Astro.props;
---
<section class="bg-mist py-16 md:py-20" data-reveal>
  <div class="container-site">
    <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">{eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight text-navy md:text-4xl">{title}</h2>
    <ol class="stagger mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      {
        steps.map((step, i) => (
          <li class="reveal relative">
            {i < steps.length - 1 && (
              <span class="journey-line pointer-events-none absolute top-7 left-[calc(50%+28px)] hidden h-0.5 w-[calc(100%-20px)] lg:block xl:block"></span>
            )}
            <p class="text-xl font-semibold text-gold">{step.n}</p>
            <span class="mt-3 grid h-10 w-10 place-items-center rounded-full border border-gold/40 bg-white text-navy">
              <Icon name="arrow" class="h-4 w-4" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-navy">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
