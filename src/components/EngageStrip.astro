---
import Button from './Button.astro';
import { deliverySteps } from '../data/stories';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<section class="relative overflow-hidden bg-navy py-16 md:py-20 text-white" data-reveal>
  <div class="pointer-events-none absolute inset-0 circuit-grid opacity-30"></div>
  <div class="container-site relative">
    <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">How we work with you</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight md:text-4xl">Discover. Scope. Build. Own.</h2>
    <ol class="stagger mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        deliverySteps.map((step) => (
          <li class="reveal rounded-xl border border-white/10 bg-white/5 p-5">
            <p class="text-lg font-semibold text-gold">{step.n}</p>
            <h3 class="mt-2 text-base font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-10 flex flex-col items-start justify-between gap-6 rounded-2xl border border-gold/40 bg-gold/10 px-6 py-6 sm:flex-row sm:items-center">
      <p class="max-w-xl text-lg font-semibold">{title}</p>
      <div class="flex flex-wrap gap-3">
        <Button href="/contact/" variant="gold">Get a Quote</Button>
        <Button href="/contact/" variant="ghost-light">Talk to an Expert</Button>
      </div>
    </div>
  </div>
</section>
