---
import Button from './Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const {
  eyebrow = 'Start a conversation',
  title,
  text = 'Tell us how the work happens today. We will help you design software that fits.',
} = Astro.props;
---
<section class="relative overflow-hidden bg-navy" data-reveal>
  <div class="pointer-events-none absolute inset-0 circuit-grid opacity-40"></div>
  <div class="pointer-events-none absolute right-0 top-0 h-48 w-48 rounded-full bg-gold/20 blur-3xl"></div>
  <div class="container-site relative flex flex-col items-start justify-between gap-8 py-16 md:flex-row md:items-center">
    <div class="max-w-xl">
      <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">{title}</h2>
      <p class="mt-3 text-sm leading-relaxed text-white/70">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Button href="/contact/" variant="gold">Get a Quote</Button>
      <Button href="/contact/" variant="ghost-light">Talk to an Expert</Button>
    </div>
  </div>
</section>
