---
import Icon from './Icon.astro';

interface Props {
  parts: { icon: string; title: string; text: string }[];
}

const { parts } = Astro.props;
---
<section class="bg-mist py-16 md:py-20" data-reveal>
  <div class="container-site">
    <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">The offering</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-navy md:text-4xl">
      Each part, explained.
    </h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
      Not a feature list. The pieces of the system, and what each one actually does in the work.
    </p>
    <ul class="stagger mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        parts.map((part) => (
          <li class="reveal rounded-2xl border border-line bg-white p-6 shadow-[0_8px_24px_rgba(18,38,63,0.04)] transition hover:-translate-y-0.5 hover:border-gold/40">
            <span class="grid h-11 w-11 place-items-center rounded-lg bg-navy text-gold">
              <Icon name={part.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 text-lg font-semibold text-navy">{part.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{part.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
