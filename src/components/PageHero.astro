---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---
<section class="border-b border-line bg-mist">
  <div class="container-site py-14 md:py-16">
    {eyebrow && (
      <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">{eyebrow}</p>
    )}
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-navy md:text-5xl">{title}</h1>
    {text && <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">{text}</p>}
  </div>
</section>
