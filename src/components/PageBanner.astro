---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  image?: ImageMetadata;
}

const { eyebrow, title, text, image } = Astro.props;
---
<section class="relative overflow-hidden bg-navy-deep text-white">
  {image && (
    <Image
      src={image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-30"
      widths={[960, 1440, 1920]}
      sizes="100vw"
    />
  )}
  <div class="pointer-events-none absolute inset-0 circuit-grid opacity-60"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-navy-deep via-navy-deep/85 to-navy-deep/55"></div>
  <div class="pointer-events-none absolute -right-16 top-0 h-56 w-56 rounded-full bg-cyan/15 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-10 bottom-0 h-40 w-40 rounded-full bg-gold/20 blur-3xl"></div>
  <div class="container-site relative py-16 md:py-20">
    {eyebrow && (
      <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">{eyebrow}</p>
    )}
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight md:text-5xl">{title}</h1>
    {text && <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/75">{text}</p>}
    <slot />
  </div>
</section>
