---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title: string;
  caption: string;
}

const { image, title, caption } = Astro.props;
---
<section class="py-16 md:py-20" data-reveal>
  <div class="container-site">
    <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">See it in the work</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight text-navy md:text-4xl">The system on the desk.</h2>
    <figure class="mt-10">
      <div class="overflow-hidden rounded-2xl border border-line shadow-[0_24px_50px_rgba(18,38,63,0.12)]">
        <div class="flex items-center gap-1.5 border-b border-line bg-mist px-4 py-2">
          <span class="h-2.5 w-2.5 rounded-full bg-navy/20"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-navy/20"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-gold"></span>
          <span class="ml-2 text-[11px] text-muted">{title}</span>
        </div>
        <Image
          src={image}
          alt={caption}
          class="aspect-[16/9] w-full object-cover"
          widths={[960, 1440]}
          sizes="(min-width: 1024px) 1100px, 100vw"
        />
      </div>
      <figcaption class="mt-4 text-sm text-muted">{caption}</figcaption>
    </figure>
  </div>
</section>
