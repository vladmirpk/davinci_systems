---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
---
<BaseLayout
  title="Terms of Service"
  description="Terms governing use of the Davinci Systems website and related enquiries."
>
  <PageBanner eyebrow="Legal" title="Terms of Service" text={`Last updated ${new Date().getFullYear()}.`} />
  <section class="container-site max-w-3xl py-14 text-[15px] leading-relaxed text-muted space-y-6">
    <p>
      By using this website you agree to these terms. Project work is governed by a separate statement of work or contract.
    </p>
    <h2 class="text-xl font-semibold text-navy">The website</h2>
    <p>
      Content is provided for general information about {site.name} and our services. We take care to keep it accurate but do not warrant that it is complete or current in every respect.
    </p>
    <h2 class="text-xl font-semibold text-navy">Enquiries</h2>
    <p>
      Submitting a form or email is a request for contact, not an offer, order or binding engagement. We may decline work that is a poor fit.
    </p>
    <h2 class="text-xl font-semibold text-navy">Intellectual property</h2>
    <p>
      Site design, copy and graphics are owned by {site.name} or used under licence. You may not copy them for commercial use without permission.
    </p>
    <h2 class="text-xl font-semibold text-navy">Liability</h2>
    <p>
      To the extent permitted by law, we are not liable for loss arising from use of this website or reliance on its contents. Nothing in these terms limits liability that cannot be limited by law.
    </p>
    <h2 class="text-xl font-semibold text-navy">Governing law</h2>
    <p>
      These terms are governed by the laws of Zimbabwe. Disputes will be subject to the courts of Zimbabwe, unless a project contract specifies otherwise.
    </p>
    <h2 class="text-xl font-semibold text-navy">Contact</h2>
    <p>{site.email} · {site.address}</p>
  </section>
</BaseLayout>
