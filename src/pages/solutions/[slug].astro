---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import JourneyFlow from '../../components/JourneyFlow.astro';
import PageBanner from '../../components/PageBanner.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { solutions } from '../../data/site';
import { serviceStories } from '../../data/stories';
import { photos, solutionPhotos } from '../../lib/photos';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return solutions.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const item = solutions.find((s) => s.slug === slug);
if (!item) throw new Error('Solution not found');
const story = serviceStories[item.slug];
const photo = photos[solutionPhotos[item.slug] ?? 'odoo'];
const others = solutions.filter((s) => s.slug !== item.slug).slice(0, 3);
---
<BaseLayout title={item.title} description={item.summary}>
  <PageBanner eyebrow="Solutions" title={item.title} text={item.summary} image={photo} />

  <section class="py-16 md:py-20" data-reveal>
    <div class="container-site grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">The problem we solve</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-navy">Explained end to end.</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">{item.description}</p>
        {story && (
          <>
            <p class="mt-6 text-sm font-semibold text-navy">Who it is for</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{story.audience}</p>
            <p class="mt-6 text-sm font-semibold text-navy">What is broken today</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{story.problem}</p>
          </>
        )}
      </div>
      <figure class="lg:col-span-6">
        <div class="overflow-hidden rounded-2xl border border-line shadow-[0_24px_50px_rgba(18,38,63,0.12)]">
          <div class="flex items-center gap-1.5 border-b border-line bg-mist px-4 py-2">
            <span class="h-2.5 w-2.5 rounded-full bg-navy/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-navy/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-gold"></span>
            <span class="ml-2 text-[11px] text-muted">{item.title}</span>
          </div>
          <Image src={photo} alt={item.title} class="aspect-[16/10] w-full object-cover" widths={[800, 1200]} sizes="(min-width: 1024px) 540px, 100vw" />
        </div>
      </figure>
    </div>
  </section>

  {story && (
    <>
      <WaveDivider from="white" to="mist" />
      <JourneyFlow
        eyebrow="The operating path"
        title={`${item.title} — from first step to a system you can run.`}
        steps={story.journey}
      />
      <WaveDivider from="mist" to="white" />

      <section class="py-16 md:py-20" data-reveal>
        <div class="container-site grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">What you get</p>
            <h2 class="mt-3 text-3xl font-semibold text-navy">{story.result}</h2>
            <ul class="mt-8 grid gap-3 sm:grid-cols-2">
              {item.outcomes.map((outcome) => (
                <li class="flex items-start gap-3 rounded-xl border border-line bg-mist px-4 py-3 text-sm text-navy">
                  <Icon name="check" class="mt-0.5 h-4 w-4 text-gold" />
                  {outcome}
                </li>
              ))}
            </ul>
          </div>
          <aside class="rounded-2xl border border-line bg-navy p-8 text-white lg:col-span-5">
            <p class="text-xs font-semibold tracking-[0.18em] text-gold uppercase">In the platform</p>
            <ul class="mt-5 grid grid-cols-2 gap-3 text-sm">
              {story.capabilities.map((cap) => (
                <li class="rounded-lg border border-white/10 bg-white/5 px-3 py-2">{cap}</li>
              ))}
            </ul>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button href="/contact/" variant="gold">Get a Quote</Button>
              <Button href="/odoo-services/" variant="ghost-light">Odoo services</Button>
            </div>
          </aside>
        </div>
      </section>
    </>
  )}

  <section class="border-t border-line bg-mist py-16" data-reveal>
    <div class="container-site">
      <h2 class="text-2xl font-semibold text-navy">Related solutions</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {others.map((other) => (
          <li>
            <a href={withBase(`/solutions/${other.slug}/`)} class="block rounded-xl border border-line bg-white p-5 hover:border-gold/40">
              <p class="font-semibold text-navy">{other.title}</p>
              <p class="mt-2 text-sm text-muted">{other.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBanner title={`Talk to us about ${item.title}.`} />
</BaseLayout>
