---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import EngageStrip from '../../components/EngageStrip.astro';
import JourneyFlow from '../../components/JourneyFlow.astro';
import OfferingGrid from '../../components/OfferingGrid.astro';
import OutcomeBand from '../../components/OutcomeBand.astro';
import PageBanner from '../../components/PageBanner.astro';
import ProductFrame from '../../components/ProductFrame.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { solutions } from '../../data/site';
import { serviceStories } from '../../data/stories';
import { photos, solutionPhotos, solutionScenes } from '../../lib/photos';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return solutions.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const item = solutions.find((s) => s.slug === slug);
if (!item) throw new Error('Solution not found');
const story = serviceStories[item.slug];
if (!story) throw new Error(`Missing story for ${item.slug}`);
const product = photos[solutionPhotos[item.slug] ?? 'odoo'];
const scene = photos[solutionScenes[item.slug] ?? solutionPhotos[item.slug] ?? 'odoo'];
const others = solutions.filter((s) => s.slug !== item.slug).slice(0, 3);
const imageLeft = (solutions.findIndex((s) => s.slug === item.slug) % 2) === 1;
---
<BaseLayout title={item.title} description={item.summary}>
  <PageBanner eyebrow="Solutions" title={item.title} text={item.summary} image={product}>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/contact/" variant="gold">Get a Quote</Button>
      <Button href="/contact/" variant="ghost-light">Talk to an Expert</Button>
    </div>
  </PageBanner>

  <section class="py-16 md:py-20" data-reveal>
    <div class="container-site grid items-center gap-12 lg:grid-cols-12">
      <div class:list={['lg:col-span-6', imageLeft && 'lg:order-2']}>
        <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">Who and why now</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-navy">The cost of staying as-is.</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">{item.description}</p>
        <p class="mt-6 text-sm font-semibold text-navy">Who it is for</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">{story.audience}</p>
        <p class="mt-6 text-sm font-semibold text-navy">What is broken today</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">{story.problem}</p>
      </div>
      <figure class:list={['lg:col-span-6', imageLeft && 'lg:order-1']}>
        <Image
          src={scene}
          alt={story.audience}
          class="aspect-[4/3] w-full rounded-2xl object-cover shadow-[0_24px_50px_rgba(18,38,63,0.12)]"
          widths={[720, 1080]}
          sizes="(min-width: 1024px) 540px, 100vw"
        />
      </figure>
    </div>
  </section>

  <WaveDivider from="white" to="mist" />
  <OfferingGrid parts={story.parts} />
  <WaveDivider from="mist" to="white" />

  <ProductFrame image={product} title={item.title} caption={story.sceneCaption} />

  <WaveDivider from="white" to="mist" />
  <JourneyFlow
    eyebrow="The operating path"
    title={`${item.title} — from first step to a system you can run.`}
    steps={story.journey}
  />
  <WaveDivider from="mist" to="white" />

  <OutcomeBand before={story.before} after={story.after} outcomes={item.outcomes} />

  <WaveDivider from="white" to="navy" />
  <EngageStrip title={`Ready to start ${item.title}? Tell us how the work happens today.`} />
  <WaveDivider from="navy" to="mist" />

  <section class="bg-mist py-16" data-reveal>
    <div class="container-site">
      <h2 class="text-2xl font-semibold text-navy">Related solutions</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          others.map((other) => (
            <li>
              <a
                href={withBase(`/solutions/${other.slug}/`)}
                class="block rounded-xl border border-line bg-white p-5 hover:border-gold/40"
              >
                <p class="font-semibold text-navy">{other.title}</p>
                <p class="mt-2 text-sm text-muted">{other.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <WaveDivider from="mist" to="navy" />
  <CtaBanner title={`Talk to us about ${item.title}.`} />
</BaseLayout>
