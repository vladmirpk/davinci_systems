---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import JourneyFlow from '../components/JourneyFlow.astro';
import PageBanner from '../components/PageBanner.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { processSteps, team, values, whyUs, site } from '../data/site';
import { photos } from '../lib/photos';
---
<BaseLayout
  title="About Us"
  description="Davinci Systems is a Harare-based software studio building ERP platforms, intelligent applications and digital systems that fit the way organisations work."
>
  <PageBanner
    eyebrow="About us"
    title="Engineering intelligence. Automating possibility."
    text="A software studio that sits with operators, then engineers platforms people can actually run."
    image={photos.about}
  />

  <section class="py-16 md:py-20" data-reveal>
    <div class="container-site grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold tracking-[0.22em] text-gold uppercase">Our story</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-navy">Built in Harare. Delivered with care.</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">
          {site.name} exists because most organisations already know how they work — they just do not have software that reflects it. We sit with operators, finance teams and leadership, then engineer platforms around that reality.
        </p>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">
          Our work spans Odoo ERP, school systems, commerce, billing, automation, AI and GIS. The common thread is practical delivery: scoped, tested, trained and supported after go-live.
        </p>
      </div>
      <Image
        src={photos.about}
        alt="Davinci Systems team collaborating in a modern office"
        class="w-full rounded-2xl object-cover shadow-[0_20px_50px_rgba(18,38,63,0.12)]"
        widths={[720, 1080]}
        sizes="(min-width: 1024px) 540px, 100vw"
      />
    </div>
  </section>

  <WaveDivider from="white" to="mist" />

  <section class="bg-mist py-16 md:py-20" data-reveal>
    <div class="container-site grid gap-8 md:grid-cols-2">
      <article class="rounded-2xl border border-line bg-white p-8">
        <h2 class="text-xl font-semibold text-navy">Mission</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          To give organisations software that matches the way they work — reliable, integrated and owned by the people who use it.
        </p>
      </article>
      <article class="rounded-2xl border border-line bg-white p-8">
        <h2 class="text-xl font-semibold text-navy">Vision</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          A region where ambitious institutions run on systems they understand, can extend, and do not have to fight every day.
        </p>
      </article>
    </div>
  </section>

  <WaveDivider from="mist" to="white" />

  <section class="py-16 md:py-20" data-reveal>
    <div class="container-site">
      <h2 class="text-3xl font-semibold tracking-tight text-navy">Values</h2>
      <div class="stagger mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((item) => (
            <article class="reveal rounded-xl border border-line p-6">
              <span class="grid h-10 w-10 place-items-center rounded-lg bg-mist text-navy">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              <h3 class="mt-4 font-semibold text-navy">{item.title}</h3>
              <p class="mt-2 text-sm text-muted">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <JourneyFlow eyebrow="How we deliver" title="The same path on every engagement." steps={processSteps.map((s) => ({ n: s.n, title: s.title, text: s.text }))} />
  <WaveDivider from="mist" to="white" />

  <section class="py-16 md:py-20" data-reveal>
    <div class="container-site">
      <h2 class="text-3xl font-semibold tracking-tight text-navy">Why organisations choose us</h2>
      <div class="stagger mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          whyUs.map((item) => (
            <article class="reveal rounded-xl border border-line bg-white p-6">
              <h3 class="font-semibold text-navy">{item.title}</h3>
              <p class="mt-2 text-sm text-muted">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-mist py-16 md:py-20" data-reveal>
    <div class="container-site">
      <h2 class="text-3xl font-semibold tracking-tight text-navy">How we are organised</h2>
      <div class="stagger mt-10 grid gap-6 md:grid-cols-3">
        {
          team.map((person) => (
            <article class="reveal rounded-xl border border-line bg-white p-6">
              <div class="grid h-14 w-14 place-items-center rounded-full bg-navy text-lg font-semibold text-gold">
                {person.name.slice(0, 1)}
              </div>
              <h3 class="mt-4 font-semibold text-navy">{person.name}</h3>
              <p class="text-xs font-medium tracking-wide text-gold uppercase">{person.role}</p>
              <p class="mt-3 text-sm text-muted">{person.bio}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner title="Work with a team that stays through go-live." />
</BaseLayout>
