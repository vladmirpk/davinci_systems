---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import PageBanner from '../../components/PageBanner.astro';
import { withBase } from '../../lib/paths';
import { photos } from '../../lib/photos';

const posts = (await getCollection('resources')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout
  title="Resources"
  description="Insights, case studies and whitepapers from Davinci Systems on ERP, Odoo, school systems and digital operations."
>
  <PageBanner
    eyebrow="Resources"
    title="Insights for teams who have to run the system."
    text="Practical writing on ERP delivery, school platforms, open-source ownership and the work that happens after go-live."
    image={photos.custom}
  />
  <section class="py-16" data-reveal>
    <div class="container-site grid gap-6 md:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={withBase(`/resources/${post.id}/`)}
            class="flex flex-col rounded-xl border border-line bg-white p-6 transition hover:border-gold/40"
          >
            <p class="text-xs font-semibold tracking-[0.16em] text-gold uppercase">{post.data.category}</p>
            <h2 class="mt-3 text-lg font-semibold text-navy">{post.data.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{post.data.description}</p>
            <p class="mt-4 text-xs text-muted">
              {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              · {post.data.readingTime}
            </p>
          </a>
        ))
      }
    </div>
  </section>
  <CtaBanner title="Want this conversation in a workshop, not an article?" />
</BaseLayout>
